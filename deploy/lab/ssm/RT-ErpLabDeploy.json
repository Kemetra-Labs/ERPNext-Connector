{
  "schemaVersion": "2.2",
  "description": "RT lab-03: deploy one pinned, attested ERPNext+Connector image by digest with check, backup, swap, migrate and pre-resume gates; the restore window closes when the scheduler resumes (RT-927).",
  "parameters": {
    "TargetDigest": {
      "type": "String",
      "description": "Registry digest of the target rt-erpnext image, sha256:<64 hex>.",
      "allowedPattern": "^sha256:[0-9a-f]{64}$",
      "interpolationType": "ENV_VAR"
    },
    "CurrentImages": {
      "type": "String",
      "description": "JSON object service -> image ref for the six ERP services as they run now (deploy #0 has a mixed map).",
      "allowedPattern": "^\\{[^\\n]{2,1000}\\}$",
      "interpolationType": "ENV_VAR"
    },
    "CurrentTree": {
      "type": "String",
      "description": "git tree hash of integrations/erpnext-connector at the commit lab-03 runs now, 40 hex.",
      "allowedPattern": "^[0-9a-f]{40}$",
      "interpolationType": "ENV_VAR"
    },
    "ExpectedVersion": {
      "type": "String",
      "description": "Connector version the target must carry, X.Y.Z.",
      "allowedPattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "interpolationType": "ENV_VAR"
    },
    "Hold": {
      "type": "String",
      "description": "true stops after the pre-resume checks with the workers down (the restore window).",
      "allowedValues": [
        "true",
        "false"
      ],
      "interpolationType": "ENV_VAR"
    },
    "RunId": {
      "type": "String",
      "description": "GitHub Actions run id; names the log and the backup folder.",
      "allowedPattern": "^[0-9]{1,20}$",
      "interpolationType": "ENV_VAR"
    },
    "SaveCurrentImage": {
      "type": "String",
      "description": "true saves the current images (docker save) into the backup folder.",
      "allowedValues": [
        "true",
        "false"
      ],
      "interpolationType": "ENV_VAR"
    },
    "MinFreeGiB": {
      "type": "String",
      "description": "Minimum free GiB under /var/backups/rt-erp at the start.",
      "allowedPattern": "^[0-9]{1,3}$",
      "interpolationType": "ENV_VAR"
    },
    "JiraKey": {
      "type": "String",
      "description": "Jira issue authorizing the run, RT-<number>.",
      "allowedPattern": "^RT-[1-9][0-9]{0,5}$",
      "interpolationType": "ENV_VAR"
    },
    "RollbackClass": {
      "type": "String",
      "description": "The preflight's rollback class for this move, recorded in the ledger.",
      "allowedValues": [
        "image-only",
        "restore"
      ],
      "interpolationType": "ENV_VAR"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deployErpImage",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "3600",
        "runCommand": [
          "set -eu",
          "umask 077",
          "RT_SCRIPT=\"$(mktemp /root/.rt-erp-deploy.XXXXXX)\"",
          "cat > \"$RT_SCRIPT\" <<'RT_ERP_SCRIPT'",
          "set -Eeuo pipefail",
          "export LC_ALL=C",
          "umask 077",
          "",
          "# RT-927 (design RT-926 v2). THIS SCRIPT IS THE SECURITY BOUNDARY: it runs as root on lab-03.",
          "# Five host steps, each stopping the run on its first failure:",
          "#   1 check    host files, one site, every ERP container on the declared image, the installed",
          "#              Connector tree equals the declared one, the site answers, free disk; pull the target.",
          "#   2 stop     stop the scheduler and the two queues; bench backup --with-files; verify it.",
          "#   3 swap     one image for all services, create (do not run) the workers, flush the cache, migrate.",
          "#   4 verify   one image id on all six containers, ping, installed app, the pre-resume probe.",
          "#              Hold mode stops here with the workers still down: the owner restore window.",
          "#   5 resume   the resume timestamp is written to the ledger BEFORE the workers run, then post-resume checks.",
          "# A failure before the swap puts the workers back. A failure after the swap leaves them down:",
          "# the owner decides between a same-class redeploy and the restore script. After the resume",
          "# timestamp exists there is NO database restore (the ledger makes restore.sh refuse).",
          "# Not covered here (workflow and owner, Task 7): the Backend-Core postings call and the heartbeat.",
          "#",
          "# Parameters arrive only as SSM_<name> environment variables (interpolationType ENV_VAR), and each",
          "# is validated again below. stdout carries only RT_* lines; everything else goes to a root-only log.",
          "",
          "# Host contract (lab-03; every item is checked first).",
          "STACK_DIR=/opt/rt-erp",
          "DC=\"$STACK_DIR/dc\"",
          "COMPOSE=\"$STACK_DIR/compose.yml\"",
          "ENV_FILE=/root/rt-lab-secrets/erp.env",
          "BACKUP_ROOT=/var/backups/rt-erp",
          "LOG_DIR=/var/log/rt-deploy",
          "LOCK=/run/rt-erp-deploy.lock",
          "IMAGE_REPO=ghcr.io/kemetra-labs/rt-erpnext",
          "SERVICES=\"backend frontend websocket scheduler queue-short queue-long\"",
          "WORKERS=\"scheduler queue-short queue-long\"",
          "BENCH_DIR=/home/frappe/frappe-bench",
          "SITE_URL=http://127.0.0.1:18000",
          "CONNECTOR_APP=retail_tower_erpnext_connector",
          "",
          "RT_PROBE_B64=''",
          "RT_TREEHASH_B64=''",
          "",
          "RESUME_MARKER=\"$BACKUP_ROOT/last-resumed-at\"",
          "",
          "STOPPED=0",
          "SWAPPED=0",
          "LEDGER=\"\"",
          "GATE=inputs",
          "",
          "RUN_ID=\"${SSM_RunId:-}\"",
          "if ! [[ \"$RUN_ID\" =~ ^[0-9]{1,20}$ ]]; then",
          "  printf 'RT_GATE inputs=fail:RunId-missing-or-invalid\\nRT_OUTCOME=failed\\n'",
          "  exit 1",
          "fi",
          "mkdir -p \"$LOG_DIR\"",
          "LOG=\"$LOG_DIR/erp-$RUN_ID.log\"",
          "# fd 3 keeps the real stdout for RT_* lines; everything else goes to the root-only log.",
          "exec 3>&1 >>\"$LOG\" 2>&1",
          "",
          "say() { printf '%s\\n' \"$*\" >&3; }",
          "",
          "# Records that posting runs again, BEFORE the workers start: in this run's ledger and in a host-wide",
          "# marker. restore.sh refuses any run that started before the marker, so a later resume (or a",
          "# recovery that restarted the workers) closes every earlier run's restore window.",
          "mark_resumed() {",
          "  RESUMED_AT=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
          "  if [ -n \"$LEDGER\" ] && [ -f \"$LEDGER\" ]; then ledger resumedAt=\"$RESUMED_AT\" || return 1; fi",
          "  mkdir -p \"$BACKUP_ROOT\" || return 1",
          "  { printf '%s\\n' \"$RESUMED_AT\" > \"$RESUME_MARKER.tmp\" && mv -f \"$RESUME_MARKER.tmp\" \"$RESUME_MARKER\"; } || return 1",
          "}",
          "",
          "recover_workers() {",
          "  if [ \"$STOPPED\" = 1 ] && [ \"$SWAPPED\" = 0 ]; then",
          "    # Posting must never resume unrecorded: if the resume cannot be written, the workers stay down",
          "    # and the owner decides (the restore window is still open, nothing was swapped).",
          "    if ! mark_resumed; then",
          "      say \"RT_GATE recover=fail:resume-not-recorded\"",
          "      return 0",
          "    fi",
          "    if \"$DC\" start $WORKERS; then",
          "      say \"RT_GATE recover=workers-restarted\"",
          "    else",
          "      say \"RT_GATE recover=fail:workers-not-restarted\"",
          "    fi",
          "  fi",
          "}",
          "",
          "stop() {",
          "  trap - ERR",
          "  echo \"stopped at gate $GATE: $*\"",
          "  say \"RT_GATE $GATE=fail:$1\"",
          "  recover_workers",
          "  say \"RT_OUTCOME=failed\"",
          "  exit 1",
          "}",
          "",
          "# With set -E the trap also runs inside $(...) subshells; only the main shell reports and recovers.",
          "trap 'rc=$?; [ \"$BASHPID\" = \"$$\" ] || exit 1; trap - ERR; echo \"unexpected failure rc=$rc at gate $GATE\"; say \"RT_GATE $GATE=fail:unexpected-error\"; recover_workers; say \"RT_OUTCOME=failed\"; exit 1' ERR",
          "",
          "# Reads the JSON ledger and sets key=value pairs (a dotted key is a nested key; a json: prefix is a",
          "# JSON value). The file is replaced atomically and stays root-only.",
          "PY_LEDGER='import json, os, sys",
          "path = sys.argv[1]",
          "try:",
          "    data = json.load(open(path))",
          "except FileNotFoundError:",
          "    data = {}",
          "for arg in sys.argv[2:]:",
          "    key, _, value = arg.partition(\"=\")",
          "    if value.startswith(\"json:\"):",
          "        value = json.loads(value[5:])",
          "    node = data",
          "    parts = key.split(\".\")",
          "    for part in parts[:-1]:",
          "        node = node.setdefault(part, {})",
          "    node[parts[-1]] = value",
          "tmp = path + \".tmp\"",
          "with open(tmp, \"w\") as handle:",
          "    json.dump(data, handle, indent=1, sort_keys=True)",
          "    handle.write(\"\\n\")",
          "os.chmod(tmp, 0o600)",
          "os.replace(tmp, path)'",
          "ledger() { python3 -c \"$PY_LEDGER\" \"$LEDGER\" \"$@\"; }",
          "",
          "# Validates the declared current images: a JSON object with exactly the six services and a known image ref each.",
          "PY_IMAGES='import json, re, sys",
          "ref_re = re.compile(r\"^(rt-erpnext:16\\.51\\.0-[0-9a-f]{12}|ghcr\\.io/kemetra-labs/rt-erpnext@sha256:[0-9a-f]{64})$\")",
          "data = json.loads(sys.argv[1])",
          "services = sys.argv[2].split()",
          "if not isinstance(data, dict) or set(data) != set(services):",
          "    sys.exit(3)",
          "if not all(isinstance(v, str) and ref_re.match(v) for v in data.values()):",
          "    sys.exit(4)",
          "for name in services:",
          "    print(name + \"=\" + data[name])'",
          "",
          "# Container and image facts. Parsed with python3 (never docker --format: Go templates need a double brace).",
          "ctr_image()    { docker inspect \"$1\" </dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin)[0][\"Config\"][\"Image\"])'; }",
          "ctr_image_id() { docker inspect \"$1\" </dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin)[0][\"Image\"])'; }",
          "ctr_running()  { docker inspect \"$1\" </dev/null | python3 -c 'import json, sys; print(str(json.load(sys.stdin)[0][\"State\"][\"Running\"]).lower())'; }",
          "ctr_label()    { docker inspect \"$1\" </dev/null | python3 -c 'import json, sys; print((json.load(sys.stdin)[0][\"Config\"].get(\"Labels\") or {}).get(sys.argv[1], \"\"))' \"$2\"; }",
          "img_id()       { docker image inspect \"$1\" </dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin)[0][\"Id\"])'; }",
          "img_label()    { docker image inspect \"$1\" </dev/null | python3 -c 'import json, sys; print((json.load(sys.stdin)[0][\"Config\"].get(\"Labels\") or {}).get(sys.argv[1], \"\"))' \"$2\"; }",
          "",
          "cid_of() { \"$DC\" ps -aq \"$1\" </dev/null; }",
          "ping_code() { curl -sS -o /dev/null -w '%{http_code}' --max-time 15 -H \"Host: $SITE\" \"$SITE_URL/api/method/ping\" || true; }",
          "wait_ping() {",
          "  local waited=0",
          "  while [ \"$waited\" -lt 150 ]; do",
          "    [ \"$(ping_code)\" = 200 ] && return 0",
          "    sleep 5",
          "    waited=$((waited + 5))",
          "  done",
          "  return 1",
          "}",
          "",
          "# ---- inputs ----",
          "TARGET_DIGEST=\"${SSM_TargetDigest:-}\"",
          "CURRENT_IMAGES=\"${SSM_CurrentImages:-}\"",
          "CURRENT_TREE=\"${SSM_CurrentTree:-}\"",
          "EXPECTED_VERSION=\"${SSM_ExpectedVersion:-}\"",
          "HOLD=\"${SSM_Hold:-}\"",
          "SAVE_CURRENT_IMAGE=\"${SSM_SaveCurrentImage:-}\"",
          "MIN_FREE_GIB=\"${SSM_MinFreeGiB:-}\"",
          "JIRA_KEY=\"${SSM_JiraKey:-}\"",
          "ROLLBACK_CLASS=\"${SSM_RollbackClass:-}\"",
          "[[ \"$TARGET_DIGEST\" =~ ^sha256:[0-9a-f]{64}$ ]] || stop \"TargetDigest-missing-or-invalid\"",
          "[[ \"$CURRENT_TREE\" =~ ^[0-9a-f]{40}$ ]] || stop \"CurrentTree-missing-or-invalid\"",
          "[[ \"$EXPECTED_VERSION\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || stop \"ExpectedVersion-missing-or-invalid\"",
          "[[ \"$HOLD\" =~ ^(true|false)$ ]] || stop \"Hold-missing-or-invalid\"",
          "[[ \"$SAVE_CURRENT_IMAGE\" =~ ^(true|false)$ ]] || stop \"SaveCurrentImage-missing-or-invalid\"",
          "[[ \"$MIN_FREE_GIB\" =~ ^[0-9]{1,3}$ ]] || stop \"MinFreeGiB-missing-or-invalid\"",
          "[[ \"$JIRA_KEY\" =~ ^RT-[1-9][0-9]{0,5}$ ]] || stop \"JiraKey-missing-or-invalid\"",
          "[[ \"$ROLLBACK_CLASS\" =~ ^(image-only|restore)$ ]] || stop \"RollbackClass-missing-or-invalid\"",
          "[ \"${#CURRENT_IMAGES}\" -le 1002 ] || stop \"CurrentImages-too-long\"",
          "declare -A CUR_IMG",
          "parse_rc=0",
          "PARSED=\"$(python3 -c \"$PY_IMAGES\" \"$CURRENT_IMAGES\" \"$SERVICES\")\" || parse_rc=$?",
          "[ \"$parse_rc\" != 3 ] || stop \"current-images-map-incomplete\"",
          "[ \"$parse_rc\" = 0 ] || stop \"current-images-invalid\"",
          "while IFS='=' read -r svc ref; do CUR_IMG[\"$svc\"]=\"$ref\"; done <<<\"$PARSED\"",
          "echo \"deploy for $JIRA_KEY run $RUN_ID: target $IMAGE_REPO@$TARGET_DIGEST (rollback class $ROLLBACK_CLASS, hold $HOLD)\"",
          "",
          "GATE=lock",
          "exec 9>\"$LOCK\"",
          "flock -n 9 || stop \"another-deploy-is-running\"",
          "WORK=\"$(mktemp -d)\"",
          "trap 'rm -rf \"$WORK\"' EXIT",
          "printf '%s' \"$RT_TREEHASH_B64\" | base64 -d > \"$WORK/tree_hash.py\"",
          "printf '%s' \"$RT_PROBE_B64\" | base64 -d > \"$WORK/preresume_probe.py\"",
          "chmod 0644 \"$WORK/tree_hash.py\" \"$WORK/preresume_probe.py\"",
          "",
          "# ---- step 1: check ----",
          "GATE=check",
          "[ -d \"$STACK_DIR\" ] && [ -f \"$COMPOSE\" ] && [ -x \"$DC\" ] && [ -f \"$ENV_FILE\" ] || stop \"host-contract-files-missing\"",
          "command -v docker >/dev/null && command -v python3 >/dev/null && command -v curl >/dev/null || stop \"host-contract-tools-missing\"",
          "BACKEND_CID=\"$(cid_of backend)\"",
          "[ -n \"$BACKEND_CID\" ] || stop \"backend-container-missing\"",
          "SITE_LIST=\"$(docker exec \"$BACKEND_CID\" sh -c 'cd sites && for d in */; do [ -f \"$d/site_config.json\" ] && echo \"${d%/}\"; done; true' </dev/null)\"",
          "SITE_COUNT=\"$(grep -c . <<<\"$SITE_LIST\" || true)\"",
          "if [ \"$SITE_COUNT\" = 1 ]; then",
          "  SITE=\"$SITE_LIST\"",
          "else",
          "  CURRENT_SITE=\"$(docker exec \"$BACKEND_CID\" sh -c 'cat sites/currentsite.txt 2>/dev/null || true' </dev/null | tr -d '[:space:]')\"",
          "  [ -n \"$CURRENT_SITE\" ] && grep -qxF \"$CURRENT_SITE\" <<<\"$SITE_LIST\" || stop \"site-not-unique\"",
          "  SITE=\"$CURRENT_SITE\"",
          "fi",
          "[[ \"$SITE\" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || stop \"site-name-invalid\"",
          "say \"RT_SITE=$SITE\"",
          "for svc in $SERVICES; do",
          "  cid=\"$(cid_of \"$svc\")\"",
          "  [ \"$(wc -w <<<\"$cid\")\" = 1 ] || stop \"service-container-count\"",
          "  [ \"$(ctr_image \"$cid\")\" = \"${CUR_IMG[$svc]}\" ] || stop \"current-image-mismatch\"",
          "done",
          "BACKEND_TREE=\"$(docker exec \"$BACKEND_CID\" true </dev/null && docker cp \"$WORK/tree_hash.py\" \"$BACKEND_CID:/tmp/tree_hash.py\" && docker exec \"$BACKEND_CID\" ./env/bin/python /tmp/tree_hash.py \"apps/$CONNECTOR_APP\" </dev/null)\" || stop \"tree-hash-failed\"",
          "[ \"$BACKEND_TREE\" = \"$CURRENT_TREE\" ] || stop \"current-tree-mismatch\"",
          "LABEL_TREE=\"$(ctr_label \"$BACKEND_CID\" rt.connector.tree)\"",
          "[ -z \"$LABEL_TREE\" ] || [ \"$LABEL_TREE\" = \"$CURRENT_TREE\" ] || stop \"current-tree-mismatch\"",
          "[ \"$(ping_code)\" = 200 ] || stop \"site-not-answering\"",
          "mkdir -p \"$BACKUP_ROOT\"",
          "AVAIL_GIB=\"$(df -BG --output=avail \"$BACKUP_ROOT\" | tail -n 1 | tr -dc '0-9')\"",
          "[ \"${AVAIL_GIB:-0}\" -ge \"$MIN_FREE_GIB\" ] || stop \"disk-low\"",
          "docker pull \"$IMAGE_REPO@$TARGET_DIGEST\" || stop \"target-pull-failed\"",
          "TARGET_IMAGE_ID=\"$(img_id \"$IMAGE_REPO@$TARGET_DIGEST\")\"",
          "[ \"$(img_label \"$IMAGE_REPO@$TARGET_DIGEST\" rt.connector.version)\" = \"$EXPECTED_VERSION\" ] || stop \"target-version-mismatch\"",
          "say \"RT_GATE check=pass\"",
          "",
          "# ---- step 2: stop + backup ----",
          "GATE=stop",
          "RUN_DIR=\"$BACKUP_ROOT/$RUN_ID\"",
          "mkdir -m 0700 \"$RUN_DIR\" || stop \"run-dir-exists\"",
          "LEDGER=\"$RUN_DIR/ledger.json\"",
          "STARTED_AT=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
          "STOPPED=1",
          "# The database writers go down first: the scheduler, then queue-short and queue-long.",
          "SCHED_CID=\"$(cid_of scheduler)\"",
          "QUEUE_CIDS=\"$(cid_of queue-short) $(cid_of queue-long)\"",
          "docker stop -t 120 $SCHED_CID || stop \"scheduler-not-stopped\"",
          "docker stop -t 120 $QUEUE_CIDS || stop \"queues-not-stopped\"",
          "[ -z \"$(\"$DC\" ps -q $WORKERS </dev/null)\" ] || stop \"workers-still-running\"",
          "say \"RT_GATE stop=pass\"",
          "",
          "GATE=backup",
          "BACKUP_DIR_IN=\"$BENCH_DIR/sites/$SITE/private/backups\"",
          "BEFORE=\"$(docker exec \"$BACKEND_CID\" sh -c \"ls -1 sites/$SITE/private/backups 2>/dev/null; true\" </dev/null | sort)\"",
          "docker exec \"$BACKEND_CID\" bench --site \"$SITE\" backup --with-files </dev/null || stop \"backup-failed\"",
          "AFTER=\"$(docker exec \"$BACKEND_CID\" sh -c \"ls -1 sites/$SITE/private/backups\" </dev/null | sort)\"",
          "NEW=\"$(comm -13 <(printf '%s\\n' \"$BEFORE\") <(printf '%s\\n' \"$AFTER\"))\"",
          "pick() { grep -E \"^[0-9]{8}_[0-9]{6}-[A-Za-z0-9._-]+-$1\\$\" <<<\"$NEW\" | head -n 1 || true; }",
          "DB_FILE=\"$(pick 'database\\.sql\\.gz')\"",
          "PUB_FILE=\"$(pick 'files\\.tar')\"",
          "PRIV_FILE=\"$(pick 'private-files\\.tar')\"",
          "CFG_FILE=\"$(pick 'site_config_backup\\.json')\"",
          "[ -n \"$DB_FILE\" ] && [ -n \"$PUB_FILE\" ] && [ -n \"$PRIV_FILE\" ] && [ -n \"$CFG_FILE\" ] || stop \"backup-files-missing\"",
          "for f in \"$DB_FILE\" \"$PUB_FILE\" \"$PRIV_FILE\" \"$CFG_FILE\"; do",
          "  docker cp \"$BACKEND_CID:$BACKUP_DIR_IN/$f\" \"$RUN_DIR/$f\" || stop \"backup-copy-failed\"",
          "done",
          "gzip -t \"$RUN_DIR/$DB_FILE\" || stop \"backup-db-corrupt\"",
          "tar -tf \"$RUN_DIR/$PUB_FILE\" >/dev/null || stop \"backup-files-corrupt\"",
          "tar -tf \"$RUN_DIR/$PRIV_FILE\" >/dev/null || stop \"backup-private-files-corrupt\"",
          "# Only the key NAME is checked; the value is never read into the log.",
          "grep -q '\"encryption_key\"' \"$RUN_DIR/$CFG_FILE\" || stop \"backup-encryption-key-missing\"",
          "(cd \"$RUN_DIR\" && sha256sum -- \"$DB_FILE\" \"$PUB_FILE\" \"$PRIV_FILE\" \"$CFG_FILE\" > SHA256SUMS)",
          "DB_SHA=\"$(sha256sum \"$RUN_DIR/$DB_FILE\" | cut -d' ' -f1)\"",
          "cp \"$COMPOSE\" \"$RUN_DIR/compose.yml\"",
          "if [ \"$SAVE_CURRENT_IMAGE\" = true ]; then",
          "  n=0",
          "  for ref in $(printf '%s\\n' \"${CUR_IMG[@]}\" | sort -u); do",
          "    n=$((n + 1))",
          "    docker save -o \"$RUN_DIR/current-image-$n.tar\" \"$ref\" || stop \"current-image-not-saved\"",
          "  done",
          "fi",
          "ledger runId=\"$RUN_ID\" jiraKey=\"$JIRA_KEY\" site=\"$SITE\" startedAt=\"$STARTED_AT\" outcome=backed-up \\",
          "  rollbackClass=\"$ROLLBACK_CLASS\" hold=\"json:$HOLD\" targetDigest=\"$TARGET_DIGEST\" \\",
          "  imagesBefore=\"json:$CURRENT_IMAGES\" digestBefore=\"${CUR_IMG[backend]}\" \\",
          "  backup.dir=\"$RUN_DIR\" backup.sha256=\"$DB_SHA\" \\",
          "  backup.files=\"json:[\\\"$DB_FILE\\\", \\\"$PUB_FILE\\\", \\\"$PRIV_FILE\\\", \\\"$CFG_FILE\\\"]\"",
          "say \"RT_BACKUP=$RUN_DIR sha256=$DB_SHA\"",
          "say \"RT_GATE backup=pass\"",
          "",
          "# ---- step 3: swap + migrate ----",
          "GATE=swap",
          "X_ERP_IMAGE_LINES=\"$(awk '/^x-erp:/ {inb=1; next} inb && /^[^ \\t#]/ {inb=0} inb && /^[ \\t]+image:/ {n++} END {print n+0}' \"$COMPOSE\")\"",
          "[ \"$X_ERP_IMAGE_LINES\" = 1 ] || stop \"x-erp-image-line-count-not-one\"",
          "awk -v ref=\"$IMAGE_REPO@$TARGET_DIGEST\" '/^x-erp:/ {inb=1; print; next} inb && /^[^ \\t#]/ {inb=0} inb && /^[ \\t]+image:/ {match($0, /^[ \\t]+/); print substr($0, 1, RLENGTH) \"image: \" ref; next} {print}' \"$COMPOSE\" > \"$RUN_DIR/compose.new\"",
          "grep -qxF \"  image: $IMAGE_REPO@$TARGET_DIGEST\" \"$RUN_DIR/compose.new\" || grep -qE \"^[ \\t]+image: $IMAGE_REPO@$TARGET_DIGEST\\$\" \"$RUN_DIR/compose.new\" || stop \"compose-edit-failed\"",
          "SWAPPED=1",
          "cp \"$RUN_DIR/compose.new\" \"$COMPOSE\"",
          "\"$DC\" up -d --no-deps backend frontend websocket || stop \"recreate-failed\"",
          "\"$DC\" up --no-start --no-deps scheduler queue-short queue-long || stop \"workers-not-created\"",
          "BACKEND_CID=\"\"",
          "for _ in $(seq 1 60); do",
          "  BACKEND_CID=\"$(cid_of backend)\"",
          "  if [ -n \"$BACKEND_CID\" ] && [ \"$(ctr_running \"$BACKEND_CID\")\" = true ]; then break; fi",
          "  sleep 2",
          "done",
          "[ -n \"$BACKEND_CID\" ] && [ \"$(ctr_running \"$BACKEND_CID\")\" = true ] || stop \"backend-not-running-after-swap\"",
          "say \"RT_GATE swap=pass\"",
          "",
          "GATE=migrate",
          "\"$DC\" exec -T redis-cache redis-cli FLUSHALL </dev/null || stop \"cache-flush-failed\"",
          "SECONDS=0",
          "MIGRATE_RC=0",
          "docker exec \"$BACKEND_CID\" bench --site \"$SITE\" migrate </dev/null || MIGRATE_RC=$?",
          "MIGRATE_SECONDS=$SECONDS",
          "say \"RT_MIGRATE rc=$MIGRATE_RC seconds=$MIGRATE_SECONDS\"",
          "ledger outcome=migrated migrate.rc=\"$MIGRATE_RC\" migrate.seconds=\"$MIGRATE_SECONDS\"",
          "[ \"$MIGRATE_RC\" = 0 ] || stop \"migrate-failed\"",
          "say \"RT_GATE migrate=pass\"",
          "",
          "# ---- step 4: verify ----",
          "GATE=verify",
          "for svc in $SERVICES; do",
          "  [ \"$(ctr_image_id \"$(cid_of \"$svc\")\")\" = \"$TARGET_IMAGE_ID\" ] || stop \"one-digest-mismatch\"",
          "done",
          "say \"RT_DIGEST_AFTER=$TARGET_DIGEST\"",
          "wait_ping || stop \"site-not-answering-after-migrate\"",
          "APPS=\"$(docker exec \"$BACKEND_CID\" bench --site \"$SITE\" list-apps </dev/null)\"",
          "grep -Eq \"^$CONNECTOR_APP +${EXPECTED_VERSION//./[.]}( |\\$)\" <<<\"$APPS\" || stop \"connector-app-not-installed\"",
          "docker cp \"$WORK/preresume_probe.py\" \"$BACKEND_CID:/tmp/preresume_probe.py\" || stop \"probe-copy-failed\"",
          "PROBE_RC=0",
          "PROBE_OUT=\"$(docker exec -w \"$BENCH_DIR/sites\" \"$BACKEND_CID\" ../env/bin/python /tmp/preresume_probe.py --site \"$SITE\" --expected-version \"$EXPECTED_VERSION\" </dev/null)\" || PROBE_RC=$?",
          "PROBE_FAILED=0",
          "while IFS= read -r line; do",
          "  if [[ \"$line\" =~ ^RT_PROBE\\ ([a-z0-9_]+)=(pass|fail)$ ]]; then",
          "    say \"RT_GATE probe_${BASH_REMATCH[1]}=${BASH_REMATCH[2]}\"",
          "    [ \"${BASH_REMATCH[2]}\" = pass ] || PROBE_FAILED=1",
          "  fi",
          "done <<<\"$PROBE_OUT\"",
          "[ \"$PROBE_RC\" = 0 ] && [ \"$PROBE_FAILED\" = 0 ] && [ -n \"$PROBE_OUT\" ] || stop \"probe-failed\"",
          "say \"RT_GATE verify=pass\"",
          "if [ \"$HOLD\" = \"true\" ]; then",
          "  ledger outcome=held finishedAt=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
          "  say \"RT_GATE ledger=pass\"",
          "  say \"RT_OUTCOME=held\"",
          "  exit 0",
          "fi",
          "",
          "# ---- resume ----",
          "GATE=resume",
          "# The resume is recorded BEFORE the workers run: from here a restore is refused, even if this step fails half way.",
          "mark_resumed",
          "ledger outcome=resumed",
          "\"$DC\" start scheduler queue-short queue-long || stop \"resume-failed\"",
          "say \"RT_RESUMED_AT=$RESUMED_AT\"",
          "say \"RT_GATE resume=pass\"",
          "",
          "# ---- post-resume checks: monitoring only, never a rollback trigger ----",
          "GATE=postresume",
          "sleep 20",
          "for worker in $WORKERS; do",
          "  [ \"$(ctr_running \"$(cid_of \"$worker\")\")\" = true ] || stop \"worker-not-running\"",
          "done",
          "wait_ping || stop \"site-not-answering-after-resume\"",
          "say \"RT_GATE postresume=pass\"",
          "",
          "# ---- step 5: ledger ----",
          "GATE=ledger",
          "ledger outcome=deployed finishedAt=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"",
          "say \"RT_GATE ledger=pass\"",
          "say \"RT_OUTCOME=deployed\"",
          "RT_ERP_SCRIPT",
          "RC=0",
          "/bin/bash \"$RT_SCRIPT\" || RC=$?",
          "rm -f \"$RT_SCRIPT\"",
          "exit \"$RC\""
        ]
      }
    }
  ]
}
